{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Al-Manjara",
  "mainBinaryName": "al-manjara",
  "version": "../package.json",
  "identifier": "com.almanjara.accounting",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "نظام إدارة ومحاسبة المنجرة",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxREI4MDc1QzFGQzQ3NTYKUldSV1IvekJkWURiMFViQUh4b3RPYkY3eEE5WDY2dkxPaUNvdEdCVlN4QVp5VnVLeTZVRm5HcmIK",
      "endpoints": [
        "https://github.com/anasashqar/Al-Manjara/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
